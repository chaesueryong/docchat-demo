# Required: used for embeddings (ingest + query)
OPENAI_API_KEY=sk-...

# Optional: if set, answers are generated with Claude instead of OpenAI
ANTHROPIC_API_KEY=

# Optional model overrides
ANSWER_MODEL_OPENAI=gpt-4o-mini
ANSWER_MODEL_ANTHROPIC=claude-sonnet-4-5
EMBEDDING_MODEL=text-embedding-3-small
